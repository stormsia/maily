# ============ mailtmapi — environment example ============
# Copy to .env and fill in your values.
# Without .env the service runs with defaults (empty API key, sqlite in CWD).

# --- General ---
# HTTP server host/port. Inside a Docker container the host must be 0.0.0.0.
MAILTM_HOST=0.0.0.0
MAILTM_PORT=8477

# API key. When set, all requests require the X-API-Key header.
# Leave empty for unauthenticated access (local/trusted network).
MAILTM_API_KEY=
# MAILTM_API_KEY=sk-your-secret-key

# Path to SQLite database (defaults to mailtm.db in current working directory).
# In Docker, volume /data is already mounted via docker-compose.
# MAILTM_DATABASE_URL=sqlite+aiosqlite:///mailtm.db
# MAILTM_DATABASE_URL=sqlite+aiosqlite:////data/mailtm.db

# Encryption key (Fernet). If empty, auto-generated and saved to mailtm.key.
# MAILTM_SECRET_KEY=

# Proxy for outbound requests to email providers (optional).
# MAILTM_PROXY=http://user:pass@127.0.0.1:8080

# Retention auto-cleanup interval in seconds.
MAILTM_RETENTION_INTERVAL_SECONDS=60

# Database maintenance (VACUUM, REINDEX, ANALYZE, PRAGMA checkpoint/optimize):
# Whether DB maintenance is enabled during retention runs.
# MAILTM_DB_MAINTENANCE_ENABLED=true
# Minimum maintenance interval in minutes (run at most once per X minutes; skipped on more frequent retention runs).
# MAILTM_DB_MAINTENANCE_INTERVAL_MINUTES=60
# SQLite busy timeout in milliseconds (app waits for DB locks to release without crashing).
# MAILTM_SQLITE_BUSY_TIMEOUT_MS=60000

# --- Gmail OAuth (optional; alternative: configure creds via admin UI) ---
# MAILTM_GMAIL_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# MAILTM_GMAIL_CLIENT_SECRET=GOCSPX-your-secret
# MAILTM_GMAIL_REDIRECT_URI=http://127.0.0.1:8477/v1/gmail/oauth/callback

# --- Dynamic X-CORS-Header for temp-mail.io provider ---
# Origin from which the X-CORS-Header secret is parsed (service homepage).
# MAILTM_TEMPMAIL_IO_ORIGIN=https://temp-mail.io
# Manual secret override (takes precedence over cache/fetch). Usually not needed.
# MAILTM_TEMPMAIL_IO_CORS_HEADER=
# TTL for cached header values in DB, seconds.
MAILTM_PROVIDER_HEADERS_TTL_SECONDS=21600

# --- temp.tf provider ---
# Allow dot-aliases for Gmail addresses (user.name@gmail.com)
# MAILTM_TEMP_TF_GMAIL_DOT=true
# Allow plus-aliases for Gmail addresses (user+tag@gmail.com)
# MAILTM_TEMP_TF_GMAIL_PLUS=true

# --- docker-compose: port exposure ---
# MAILTM_PORT=8477  # same port published by compose (8477:8477)
