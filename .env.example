# ============ mailtmapi — пример окружения ============
# Скопируй в .env и заполни своими значениями.
# Без .env сервис работает с дефолтами (пустой API-ключ, sqlite в CWD).

# --- Общее ---
# Хост/порт HTTP-сервера. В Docker контейнере хост должен быть 0.0.0.0.
MAILTM_HOST=0.0.0.0
MAILTM_PORT=8477

# API-ключ. Если задан — все запросы требуют заголовок X-API-Key.
# Оставь пустым для работы без авторизации (локально/на доверенной сети).
MAILTM_API_KEY=
# MAILTM_API_KEY=sk-your-secret-key

# Путь к SQLite БД (по умолчанию mailtm.db в рабочей директории).
# В контейнере volume /data уже настроен в docker-compose.
# MAILTM_DATABASE_URL=sqlite+aiosqlite:///mailtm.db
# MAILTM_DATABASE_URL=sqlite+aiosqlite:////data/mailtm.db

# Ключ шифрования (Fernet). Если пуст — генерируется и сохраняется в mailtm.key.
# MAILTM_SECRET_KEY=

# Прокси для исходящих запросов к провайдерам (опционально).
# MAILTM_PROXY=http://user:pass@127.0.0.1:8080

# Интервал авто-очистки retention, секунд.
MAILTM_RETENTION_INTERVAL_SECONDS=60

# --- Gmail OAuth (опционально; альтернатива — задать creds через админку) ---
# MAILTM_GMAIL_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# MAILTM_GMAIL_CLIENT_SECRET=GOCSPX-your-secret
# MAILTM_GMAIL_REDIRECT_URI=http://127.0.0.1:8477/v1/gmail/oauth/callback

# --- Динамический X-CORS-Header для temp-mail.io (провайдер) ---
# Origin, с которого парсится секрет X-CORS-Header (главная страница сервиса).
# MAILTM_TEMPMAIL_IO_ORIGIN=https://temp-mail.io
# Ручная перезапись секрета (приоритет над кэшем/фетчем). Обычно не нужна.
# MAILTM_TEMPMAIL_IO_CORS_HEADER=
# TTL кэша значений заголовков в БД, секунд.
MAILTM_PROVIDER_HEADERS_TTL_SECONDS=21600

# --- docker-compose: проброс наружу ---
# MAILTM_PORT=8477  # тот же порт, что публикует compose (8477:8477)